/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running single-cell PCA reconstruction tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a single-cell PCA reconstruction
    pipeline test with H5AD data format.

    Use as follows:
        nextflow run nf-core/deepmodeloptim -profile test_singlecell,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Single-cell PCA reconstruction test profile'
    config_profile_description = 'Single-cell PCA reconstruction test with VCC subset data'

    // Input data (local paths - update these for your environment)
    data         = '/Users/mgrapotte/Labwork/stimulus/stimulus-py/tests/test_data/vcc_subset/vcc_training_subset.h5ad'
    data_config  = '/Users/mgrapotte/Labwork/stimulus/deepmodeloptim/assets/singlecell_pca_config.yaml'
    model        = '/Users/mgrapotte/Labwork/stimulus/stimulus-py/examples/pca_reconstructor.py'
    model_config = '/Users/mgrapotte/Labwork/stimulus/stimulus-py/examples/pca_reconstruction_config.yaml'

    // Output
    save_data    = true
    skip_encoding = true

    // Optuna dashboard support - enables real-time visualization
    // After pipeline completes, the exact command to view the dashboard will be printed
    optuna_storage    = "sqlite:///${launchDir}/results/optuna_study.db"
    optuna_study_name = "singlecell-pca-test"
}

// Limit resources for local testing
process {
    maxRetries = params.max_retries
    errorStrategy = params.err_start

    withLabel:process_low {
        cpus   = { 1                    }
        memory = { 4.GB * task.attempt  }
        time   = { 10.m  * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 2                    }
        memory = { 8.GB * task.attempt  }
        time   = { 30.m  * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 4                    }
        memory = { 16.GB * task.attempt }
        time   = { 2.h  * task.attempt  }
    }
}
